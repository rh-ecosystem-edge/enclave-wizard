{
  "biome.enabled": true,
  "biome.requireConfiguration": true,
  "biome.configurationPath": "./ui/biome.json",
  "biome.lsp.bin": {
    "darwin-arm64": "./ui/node_modules/@biomejs/cli-darwin-arm64/biome",
    "darwin-x64": "./ui/node_modules/@biomejs/cli-darwin-x64/biome",
    "linux-x64": "./ui/node_modules/@biomejs/cli-linux-x64/biome",
    "linux-arm64": "./ui/node_modules/@biomejs/cli-linux-arm64/biome",
    "win32-x64": "./ui/node_modules/@biomejs/cli-win32-x64/biome.exe"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  }
}
