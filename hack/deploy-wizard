#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

if [ $# -lt 1 ]; then
    echo "Usage: $0 <user@host>"
    echo "Example: $0 root@myserver.example.com"
    exit 1
fi

TARGET="$1"
AUTH="${AUTH:-}"
SSH="ssh -o StrictHostKeyChecking=no"
SCP="scp -o StrictHostKeyChecking=no -q"

VM_NAME="enclave-wizard-lz"
VM_MEMORY=4096
VM_CPUS=2
VM_DISK_SIZE=60
HTTP_PORT=3001
HTTPS_PORT=3443
CLOUD_IMAGE_URL="https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2"

echo "=== Deploying Enclave Wizard to ${TARGET} (in VM) ==="

# --- Find build artifacts ---
WIZARD_RPM=$(ls -t "${REPO_DIR}/out/"enclave-wizard-*.rpm 2>/dev/null | head -1)
ENCLAVE_TARBALL="${REPO_DIR}/out/enclave-repo.tar.gz"
if [ -z "${WIZARD_RPM}" ]; then
    echo "ERROR: No wizard RPM found in out/. Run 'make rpm' first."
    exit 1
fi
if [ ! -f "${ENCLAVE_TARBALL}" ]; then
    echo "ERROR: No enclave tarball found in out/. Run 'make enclave-tarball' first."
    exit 1
fi
echo "  Wizard RPM:     $(basename ${WIZARD_RPM})"
echo "  Enclave source: $(basename ${ENCLAVE_TARBALL})"

# --- Step 1: Transfer build artifacts to target host ---
echo ""
echo "[1/6] Transferring build artifacts to target host..."
${SCP} "${WIZARD_RPM}" "${TARGET}:/tmp/enclave-wizard.rpm"
${SCP} "${ENCLAVE_TARBALL}" "${TARGET}:/tmp/enclave-repo.tar.gz"

# --- Step 2: Download Fedora Cloud image on target ---
echo "[2/6] Preparing VM image on target..."
${SSH} "${TARGET}" "
  set -e
  IMG_DIR=/var/lib/libvirt/images
  IMAGE_CACHE=\${IMG_DIR}/CentOS-Stream-9-GenericCloud.qcow2

  if [ ! -f \${IMAGE_CACHE} ]; then
    echo '  Downloading CentOS Stream 9 Cloud image...'
    curl -L -o \${IMAGE_CACHE} '${CLOUD_IMAGE_URL}'
  else
    echo '  CentOS image cached'
  fi

  # Destroy old VM if present
  virsh destroy ${VM_NAME} 2>/dev/null || true
  virsh undefine ${VM_NAME} --remove-all-storage --nvram 2>/dev/null || true
  sleep 1

  # Create VM disk
  qemu-img create -f qcow2 -b \${IMAGE_CACHE} -F qcow2 \
    \${IMG_DIR}/${VM_NAME}.qcow2 ${VM_DISK_SIZE}G
"

# --- Step 3: Create cloud-init and boot VM ---
echo "[3/6] Booting VM..."
LOCAL_SSH_KEY=$(cat ~/.ssh/id_rsa.pub)
${SSH} "${TARGET}" "
  set -e
  IMG_DIR=/var/lib/libvirt/images
  CI_DIR=\$(mktemp -d)

  cat > \${CI_DIR}/meta-data <<CIEOF
instance-id: ${VM_NAME}
local-hostname: ${VM_NAME}
CIEOF

  cat > \${CI_DIR}/user-data <<CIEOF
#cloud-config
users:
  - name: wizard
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${LOCAL_SSH_KEY}
      - \$(cat ~/.ssh/id_rsa.pub 2>/dev/null || echo '')

packages:
  - curl
  - openssl
CIEOF

  mkisofs -output \${IMG_DIR}/${VM_NAME}-cidata.iso \
    -volid cidata -joliet -rock \
    \${CI_DIR}/meta-data \${CI_DIR}/user-data 2>/dev/null
  rm -rf \${CI_DIR}

  virt-install \
    --name ${VM_NAME} \
    --memory ${VM_MEMORY} \
    --vcpus ${VM_CPUS} \
    --disk path=\${IMG_DIR}/${VM_NAME}.qcow2,format=qcow2 \
    --disk path=\${IMG_DIR}/${VM_NAME}-cidata.iso,device=cdrom \
    --os-variant centos-stream9 \
    --network default \
    --graphics none \
    --console pty,target_type=serial \
    --noautoconsole \
    --import \
    --quiet
"

# --- Step 4: Wait for VM IP and SSH ---
echo "[4/6] Waiting for VM..."
VM_IP=""
for i in $(seq 1 60); do
    VM_IP=$(${SSH} "${TARGET}" "virsh domifaddr ${VM_NAME} 2>/dev/null | grep -oP '(\d+\.){3}\d+' | head -1" 2>/dev/null) || true
    if [ -n "${VM_IP}" ]; then
        break
    fi
    sleep 2
done

if [ -z "${VM_IP}" ]; then
    echo "ERROR: VM did not get an IP after 120 seconds"
    exit 1
fi
echo "  VM IP: ${VM_IP}"

# Libvirt reuses DHCP-leased IPs across VM (re)creations. A previous VM's
# host key at this IP would otherwise trigger a hard host-key-mismatch abort
# that StrictHostKeyChecking=no does NOT suppress (only unknown hosts, not
# changed ones) — on both our own known_hosts and the target host's, since
# some steps below run ssh/scp to the VM from the target host itself.
ssh-keygen -R "${VM_IP}" >/dev/null 2>&1 || true
${SSH} "${TARGET}" "ssh-keygen -R ${VM_IP} 2>/dev/null || true"

# Wait for SSH inside VM (via target as jump host)
echo "  Waiting for SSH..."
for i in $(seq 1 30); do
    ${SSH} -J "${TARGET}" wizard@"${VM_IP}" "echo ready" 2>/dev/null && break
    sleep 2
done

# --- Step 5: Provision inside VM ---
echo "[5/6] Provisioning VM..."

# Transfer build artifacts from target host into VM
${SSH} "${TARGET}" "
  scp -o StrictHostKeyChecking=no /tmp/enclave-wizard.rpm /tmp/enclave-repo.tar.gz wizard@${VM_IP}:/tmp/
"

${SSH} -J "${TARGET}" wizard@"${VM_IP}" "
  echo '  Waiting for cloud-init...'
  sudo cloud-init status --wait 2>/dev/null || sleep 10
  echo '  cloud-init done.'

  echo '  Extracting enclave source to /opt/enclave...'
  sudo mkdir -p /opt/enclave
  sudo tar xzf /tmp/enclave-repo.tar.gz --strip-components=1 -C /opt/enclave
  sudo chown -R \"\$(id -un):\$(id -gn)\" /opt/enclave

  echo '  Running enclave setup_env.sh (system packages)...'
  cd /opt/enclave && sudo bash setup_env.sh 2>&1 | tail -10

  echo '  Running enclave setup_ansible.sh (uv, ansible, collections)...'
  cd /opt/enclave && bash setup_ansible.sh 2>&1 | tail -20

  echo '  Adding ansible-runner (required by the wizard, not by enclave itself)...'
  \"\${HOME}/.local/bin/uv\" tool install --force /opt/enclave \
      --with-executables-from ansible-core \
      --with-executables-from ansible-runner \
      --with ansible-runner 2>&1 | tail -5

  if [ ! -f \"\${HOME}/.ssh/id_rsa\" ]; then
    ssh-keygen -t rsa -b 4096 -f \"\${HOME}/.ssh/id_rsa\" -N '' -q
  fi

  echo '  Installing wizard RPM...'
  sudo dnf install -y /tmp/enclave-wizard.rpm 2>&1 | tail -5
  echo '  Wizard RPM installed.'

  # Point the wizard at wherever this deploy actually installed ansible-runner
  # (this user's home), rather than the RPM unit's dedicated-user default.
  printf 'SERVICE_ANSIBLE_BIN_DIR=%s/.local/bin\nHOME=%s\nXDG_CACHE_HOME=%s/.cache\n' \"\${HOME}\" \"\${HOME}\" \"\${HOME}\" | sudo tee /etc/enclave-wizard/environment > /dev/null
  sudo systemctl daemon-reload
  sudo systemctl restart enclave-wizard
" 2>&1 | grep -v "^$"

# Attach BMC network if bm-emulation was set up
BMC_VM_IP=""
if ${SSH} "${TARGET}" "virsh net-info enclave-bmc" &>/dev/null; then
  HAS_BMC=$(${SSH} "${TARGET}" "virsh domiflist ${VM_NAME} | grep -c enclave-bmc" 2>/dev/null || echo "0")
  if [ "${HAS_BMC}" = "0" ]; then
    ${SSH} "${TARGET}" "virsh attach-interface ${VM_NAME} network enclave-bmc --model virtio --config --live"
    sleep 5
  fi
  # Extract cluster DNS entries from the BMC network and add to /etc/hosts
  ${SSH} "${TARGET}" "
    virsh net-dumpxml enclave-bmc 2>/dev/null | python3 -c \"
import sys, xml.etree.ElementTree as ET
root = ET.parse(sys.stdin).getroot()
for host in root.findall('.//dns/host'):
    ip = host.get('ip')
    names = ' '.join(h.text for h in host.findall('hostname'))
    if names: print(f'{ip} {names}')
\" > /tmp/enclave-bmc-hosts.txt 2>/dev/null
    scp -o StrictHostKeyChecking=no /tmp/enclave-bmc-hosts.txt wizard@${VM_IP}:/tmp/enclave-bmc-hosts.txt
  " 2>/dev/null || true
  ${SSH} -J "${TARGET}" wizard@"${VM_IP}" "
    sudo nmcli con mod 'Wired connection 2' ipv4.dns '192.168.223.1' ipv4.dns-priority -10 2>/dev/null || true
    sudo nmcli con up 'Wired connection 2' 2>/dev/null || true
    # Add BMC DNS entries to /etc/hosts for reliable resolution
    if [ -f /tmp/enclave-bmc-hosts.txt ]; then
      sudo sed -i '/enclave-test.lab.local/d' /etc/hosts
      cat /tmp/enclave-bmc-hosts.txt | sudo tee -a /etc/hosts > /dev/null
    fi
  " 2>/dev/null || true
  for _attempt in 1 2 3 4 5; do
    BMC_VM_IP=$(${SSH} -J "${TARGET}" wizard@"${VM_IP}" "ip -4 addr 2>/dev/null | grep -oP 'inet 192\.168\.223\.\K[0-9]+'" 2>/dev/null || echo "")
    [ -n "${BMC_VM_IP}" ] && BMC_VM_IP="192.168.223.${BMC_VM_IP}" && break
    sleep 3
  done

  # Set lzBmcIP in global.yaml to current VM IP (primary network, not BMC)
  ${SSH} -J "${TARGET}" wizard@"${VM_IP}" "
    sudo sed -i 's|lzBmcIP:.*|lzBmcIP: ${VM_IP}|' /opt/enclave/config/global.yaml 2>/dev/null || true
  " 2>/dev/null
  echo "  lzBmcIP set to ${VM_IP}"

  # Add mirror DNS entry to BMC network pointing to wizard VM
  if [ -n "${BMC_VM_IP}" ]; then
    ${SSH} "${TARGET}" "
      virsh net-update enclave-bmc add dns-host '<host ip=\"${BMC_VM_IP}\"><hostname>mirror.enclave-test.lab.local</hostname></host>' --live --config 2>/dev/null || true
    "
    # Also add to /etc/hosts on wizard VM
    ${SSH} -J "${TARGET}" wizard@"${VM_IP}" "
      echo '${BMC_VM_IP} mirror.enclave-test.lab.local' | sudo tee -a /etc/hosts > /dev/null
    " 2>/dev/null || true
  fi
fi

# Disable auth if requested
if [ "${AUTH}" = "none" ]; then
  ${SSH} -J "${TARGET}" wizard@"${VM_IP}" "
    sudo sed -i 's|ExecStart=.*|& --no-auth|' /etc/systemd/system/enclave-wizard.service
    sudo systemctl daemon-reload
    sudo systemctl restart enclave-wizard
  " 2>/dev/null
  echo "  Auth disabled (--no-auth)"
  sleep 2
fi

# --- Step 6: Set up port forwarding and verify ---
echo "[6/6] Setting up port forwarding and verifying..."

# Set up port forwarding using iptables NAT (works with external access,
# PREROUTING DNAT bypasses firewalld zone rules)
${SSH} "${TARGET}" "
  sysctl -w net.ipv4.ip_forward=1 >/dev/null

  # Clean up ALL existing rules for our ports (from any previous VM)
  cleanup_rules() {
    local table=\$1 chain=\$2 port=\$3
    while true; do
      LINE=\$(iptables -t \$table -L \$chain -n --line-numbers 2>/dev/null | grep \"dpt:\$port\" | head -1 | awk '{print \$1}')
      [ -z \"\$LINE\" ] && break
      iptables -t \$table -D \$chain \$LINE
    done
  }
  cleanup_rules nat PREROUTING ${HTTPS_PORT}
  cleanup_rules nat PREROUTING ${HTTP_PORT}
  cleanup_rules nat OUTPUT ${HTTPS_PORT}
  cleanup_rules nat OUTPUT ${HTTP_PORT}

  # Clean up old FORWARD and MASQUERADE rules for wizard VMs
  while true; do
    LINE=\$(iptables -L FORWARD -n --line-numbers 2>/dev/null | grep -E '${HTTP_PORT}|${HTTPS_PORT}' | head -1 | awk '{print \$1}')
    [ -z \"\$LINE\" ] && break
    iptables -D FORWARD \$LINE
  done
  while true; do
    LINE=\$(iptables -t nat -L POSTROUTING -n --line-numbers 2>/dev/null | grep '192.168.122' | grep MASQUERADE | head -1 | awk '{print \$1}')
    [ -z \"\$LINE\" ] && break
    iptables -t nat -D POSTROUTING \$LINE
  done

  # DNAT external + local traffic to the VM
  iptables -t nat -A PREROUTING -p tcp --dport ${HTTPS_PORT} -j DNAT --to-destination ${VM_IP}:${HTTPS_PORT}
  iptables -t nat -A PREROUTING -p tcp --dport ${HTTP_PORT} -j DNAT --to-destination ${VM_IP}:${HTTP_PORT}
  iptables -t nat -A OUTPUT -p tcp --dport ${HTTPS_PORT} -j DNAT --to-destination ${VM_IP}:${HTTPS_PORT}
  iptables -t nat -A OUTPUT -p tcp --dport ${HTTP_PORT} -j DNAT --to-destination ${VM_IP}:${HTTP_PORT}
  iptables -t nat -A POSTROUTING -d ${VM_IP} -j MASQUERADE
  iptables -I FORWARD 1 -d ${VM_IP} -p tcp -m multiport --dports ${HTTP_PORT},${HTTPS_PORT} -j ACCEPT

  # Save VM IP for teardown
  echo '${VM_IP}' > /tmp/enclave-wizard-vm-ip
"

sleep 3

# Verify
TARGET_HOST=$(echo "${TARGET}" | cut -d@ -f2)

HTTPS_OK=false
REDIRECT_OK=false
EXT_OK=false

${SSH} -J "${TARGET}" wizard@"${VM_IP}" "curl -sfk https://localhost:${HTTPS_PORT}/wizard" > /dev/null 2>&1 && HTTPS_OK=true
REDIRECT_CODE=$(${SSH} -J "${TARGET}" wizard@"${VM_IP}" "curl -so /dev/null -w '%{http_code}' http://localhost:${HTTP_PORT}" 2>/dev/null || true)
[ "${REDIRECT_CODE}" = "301" ] && REDIRECT_OK=true
curl -sfk --connect-timeout 5 "https://${TARGET_HOST}:${HTTPS_PORT}/wizard" > /dev/null 2>&1 && EXT_OK=true

echo ""
echo "  HTTPS (VM):          $( $HTTPS_OK && echo 'OK' || echo 'FAIL' )"
echo "  HTTP→HTTPS redirect: $( $REDIRECT_OK && echo 'OK (301)' || echo "FAIL (got ${REDIRECT_CODE})" )"
echo "  HTTPS (external):   $( $EXT_OK && echo 'OK' || echo 'FAIL - check port forwarding' )"
echo ""

if $HTTPS_OK; then
    WIZARD_PASS=$(${SSH} -J "${TARGET}" wizard@"${VM_IP}" "sudo cat /tmp/enclave-wizard-init-pass 2>/dev/null" 2>/dev/null || echo "(could not retrieve)")

    # Merge wizard params into demo-params.json
    PARAMS_FILE="${REPO_DIR}/demo-params.json"
    python3 -c "
import json, os
path = '${PARAMS_FILE}'
data = {}
if os.path.exists(path):
    with open(path) as f:
        data = json.load(f)
data['wizard'] = {
    'url': 'https://${TARGET_HOST}:${HTTPS_PORT}/wizard',
    'password': '${WIZARD_PASS}',
    'vmIP': '${VM_IP}',
    'lzBmcIP': '${BMC_VM_IP}',
    'target': '${TARGET}',
    'sshJump': 'ssh -J ${TARGET} wizard@${VM_IP}',
}
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
print(f'  Params written to {os.path.realpath(path)}')
"

    echo "Wizard URL:     https://${TARGET_HOST}:${HTTPS_PORT}/wizard"
    echo "Password:       ${WIZARD_PASS}"
    [ -n "${BMC_VM_IP}" ] && echo "Landing Zone IP: ${BMC_VM_IP}  (on BMC network)"
    echo "VM SSH:         ssh -J ${TARGET} wizard@${VM_IP}"
    echo ""
    echo "  (Self-signed cert — accept the browser warning)"
    echo ""
    echo "To remove:  ./hack/teardown-wizard ${TARGET}"
else
    echo "Deployment failed. Check logs with:"
    echo "  ssh -J ${TARGET} wizard@${VM_IP} 'sudo journalctl -u enclave-wizard-api -u enclave-wizard-ui --no-pager -n 20'"
    exit 1
fi
