#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: $0 <user@host>"
    echo "Example: $0 root@myserver.example.com"
    exit 1
fi

TARGET="$1"
HTTP_PORT=3001
HTTPS_PORT=3443

echo "=== Tearing down Enclave Wizard on ${TARGET} ==="

# Read state file
STATE=$(ssh -o StrictHostKeyChecking=no "${TARGET}" "cat /tmp/enclave-wizard-env 2>/dev/null" || true)
if [ -z "${STATE}" ]; then
    echo "WARNING: No state file found at /tmp/enclave-wizard-env"
    echo "  Cleaning up iptables rules only"
fi

MODE=$(echo "${STATE}" | grep '^MODE=' | cut -d= -f2 || echo "")
LZ_IP=$(echo "${STATE}" | grep '^LZ_IP=' | cut -d= -f2 || echo "")

# Clean up iptables rules
ssh -o StrictHostKeyChecking=no "${TARGET}" "
    cleanup_rules() {
        local table=\$1 chain=\$2 port=\$3
        while true; do
            LINE=\$(iptables -t \$table -L \$chain -n --line-numbers 2>/dev/null | grep \"dpt:\$port\" | head -1 | awk '{print \$1}')
            [ -z \"\$LINE\" ] && break
            iptables -t \$table -D \$chain \$LINE
        done
    }
    cleanup_rules nat PREROUTING ${HTTPS_PORT}
    cleanup_rules nat PREROUTING ${HTTP_PORT}
    cleanup_rules nat OUTPUT ${HTTPS_PORT}
    cleanup_rules nat OUTPUT ${HTTP_PORT}

    while true; do
        LINE=\$(iptables -L FORWARD -n --line-numbers 2>/dev/null | grep -E '${HTTP_PORT}|${HTTPS_PORT}' | head -1 | awk '{print \$1}')
        [ -z \"\$LINE\" ] && break
        iptables -D FORWARD \$LINE
    done
    while true; do
        LINE=\$(iptables -t nat -L POSTROUTING -n --line-numbers 2>/dev/null | grep MASQUERADE | head -1 | awk '{print \$1}')
        [ -z \"\$LINE\" ] && break
        iptables -t nat -D POSTROUTING \$LINE
    done
"

VM_NAME=$(echo "${STATE}" | grep '^VM_NAME=' | cut -d= -f2 || echo "")

# Mode-specific cleanup
if [ "${MODE}" = "enclave" ]; then
    echo "Cleaning up enclave infrastructure..."
    ssh -o StrictHostKeyChecking=no "${TARGET}" "
        cd \${HOME}/enclave 2>/dev/null && DEV_SCRIPTS_PATH=\${DEV_SCRIPTS_PATH:-\${HOME}/dev-scripts} make -f Makefile.ci clean || echo 'Enclave cleanup skipped (repo not found)'
    "
elif [ "${MODE}" = "standalone" ]; then
    if [ -n "${VM_NAME}" ]; then
        echo "Destroying standalone VM: ${VM_NAME}..."
        ssh -o StrictHostKeyChecking=no "${TARGET}" "
            virsh destroy ${VM_NAME} 2>/dev/null || true
            virsh undefine ${VM_NAME} --remove-all-storage --nvram 2>/dev/null || true
        "
    fi
    echo "Tearing down BMC emulation..."
    scp -o StrictHostKeyChecking=no -q "$(dirname "$0")/infra/teardown-bm-emulation.sh" "${TARGET}:/tmp/teardown-bm-emulation.sh"
    ssh -o StrictHostKeyChecking=no "${TARGET}" "bash /tmp/teardown-bm-emulation.sh"
fi

# Remove state and temp files
ssh -o StrictHostKeyChecking=no "${TARGET}" "
    rm -f /tmp/enclave-wizard-env /tmp/enclave.rpm /tmp/enclave-wizard.rpm
"

echo "Done."
