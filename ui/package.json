{
  "name": "enclave-wizard-ui",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:all": "yarn workspaces foreach -t --all run build",
    "clean:all": "rm -rf out && yarn workspaces foreach --all -p run clean",
    "check:all": "biome check .",
    "check:fix:all": "biome check --write .",
    "test:all": "yarn workspace @enclave-wizard-ui/wizard test",
    "typecheck:all": "yarn build:all",
    "start": "concurrently -k -n api,ui -c blue,green \"make -C .. dev\" \"yarn workspace @enclave-wizard-ui/wizard start\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "~6.3.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.7.0",
    "vite": "~8.3.8"
  },
  "resolutions": {
    "vite": "~8.3.8"
  },
  "packageManager": "yarn@4.12.0"
}
